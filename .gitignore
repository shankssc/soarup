# === ROOT .gitignore for SoarUp ===

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.venv/
venv/
ENV/
env/
*.log
alembic.ini
*.db
sqlite.db

# --- Node / Next.js / Frontend ---
node_modules/
.next/
out/
build/
dist/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/
*.local

# --- Docker ---
*.env.local
*.env.*.local
docker-compose.override.yml
minio_data/
postgres_data/
redis_data/

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets & Sensitive ---
!.secrets.baseline
!.secrets.baseline.example
*.pem
*.key
*.crt

# --- Testing & Coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/
*.lcov

# --- Storybook ---
storybook-static/

# --- Logs ---
logs/
*.log

# --- Environment (keep example, ignore actual) ---
.env
!.env.example

# --- Specs (keep, but ignore local drafts) ---
specs/*.draft.md

# --- Allow specs and app code ---
!specs/
!apps/
!.github/
