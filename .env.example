# .env.example - SoarUp Environment Variables Template
# Copy to .env and fill in values. DO NOT commit .env to version control.

# === Backend (apps/api) ===

# Environment
ENVIRONMENT=local
NEXT_PUBLIC_ENVIRONMENT=local

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@supabase_db_soarup:5432/postgres
# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0

# Cloudflare R2 (production) / Minio (local dev)
R2_ENDPOINT_URL=http://minio:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000
R2_BUCKET_NAME=soarup-local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin

# Supabase Auth

# Local dev: Supabase Auth issues tokens with issuer=http://127.0.0.1:54321
# If you change SUPABASE_URL to host.docker.internal, issuer validation is
# automatically skipped in local env. This is safe for development only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_ANON_KEY=your-supabase-publishable-key

# AI Services
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Notifications
RESEND_API_KEY=re_your-resend-key-here
NOVU_API_KEY=novu_your-novu-key-here

# Observability
SENTRY_DSN=https://your-sentry-dsn-here
NEXT_PUBLIC_SENTRY_DSN=https://your-nextjs-sentry-dsn-here

# === Frontend (apps/web) ===

# API URLs (public, exposed to browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Supabase (public anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Slack integration service
SLACK_INTEGRATION_ENABLED=false
# Required when SLACK_INTEGRATION_ENABLED=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SLACK_ENCRYPTION_KEY=your-fernet-generated-encryption-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# === Email Delivery Invite/Subscribe/Unsubscribe
UNSUBSCRIBE_SECRET_KEY=your-generated-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# === Optional / Future ===
# Slack webhook for digest delivery

# Stripe for billing (future pro tier)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
