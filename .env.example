# .env.example - SoarUp Environment Variables Template
# Copy to .env and fill in values. DO NOT commit .env to version control.

# === Backend (apps/api) ===

# Environment
ENVIRONMENT=local

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/soarup

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0

# Cloudflare R2 (production) / Minio (local dev)
R2_ENDPOINT_URL=http://minio:9000
R2_BUCKET_NAME=soarup-local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here

# AI Services
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Notifications
RESEND_API_KEY=re_your-resend-key-here
NOVU_API_KEY=novu_your-novu-key-here

# Observability
SENTRY_DSN=https://your-sentry-dsn-here

# === Frontend (apps/web) ===

# API URLs (public, exposed to browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Supabase (public anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# === Optional / Future ===
# Slack webhook for digest delivery
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Stripe for billing (future pro tier)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...