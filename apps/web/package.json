    "prettier-plugin-tailwindcss": "^0.6.8",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.9",
