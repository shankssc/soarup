{
  "name": "@soarup/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\" \"tests/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\" \"tests/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run type-check",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:all": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "react-doctor": "npx react-doctor@latest",
    "prepare": "husky",
    "pages:build": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
